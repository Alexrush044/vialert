# ============================================================================
#  VIALERT · configuracion.   cp .env.example .env   y edita.   NUNCA subas .env a git.
#  Despues de cambiar algo, reinicia (docker compose up -d  /  ./run.sh).
# ============================================================================

# --- 1. Modelo en la nube (Huawei Cloud MaaS) -------------------------------
# Sin MAAS_API_KEY la app corre en modo SIMULADO (la interfaz lo marca en rojo; resultados no reales).
MAAS_API_KEY=
# MAAS_MODEL=deepseek-v4.1-flash
# MAAS_URL=https://api-ap-southeast-1.modelarts-maas.com/v2/chat/completions
# RPM_LIMIT=90              # tope de peticiones/min hacia MaaS (tu cuota); todas las camaras lo comparten

# --- 2. Acceso a la interfaz (OBLIGATORIO si el puerto es alcanzable desde fuera) ---
DEMO_USER=admin
DEMO_PASS=cambia_esta_clave
# VIALERT_PORT=8000         # solo docker compose

# --- 3. OPCIONAL: celulares / equipos que TRANSMITEN al servidor (MediaMTX) ---
# Las camaras IP / NVR normales NO usan esto (Vialert se conecta a ellas con su propio usuario/clave, o sin clave si no la tienen).
# Solo si usaras celulares (Larix), drones o codificadores: docker compose --profile publish up -d  y define estas claves
# (solo letras, numeros, _ . -):
# MTX_PUBLISH_USER=cam
# MTX_PUBLISH_PASS=cambia_clave_publicar
# MTX_READ_PASS=cambia_clave_lectura
# Instalacion sin Docker: tools/install_mediamtx.sh; Vialert lee la clave de /opt/mediamtx/mediamtx.yml (MTX_PUBLISH_PASS puede quedar igual).
# MTX_READ_URL=rtsp://127.0.0.1:8554    # desde donde Vialert lee lo que publican (compose lo fija solo)
# MTX_RTSP_PORT=8554  MTX_RTMP_PORT=1935
# PUBLIC_HOST=                          # IP/DNS que ven los celulares; vacio = el host con el que abres la pagina

# --- 4. Camaras en vivo ------------------------------------------------------
# Se agregan y quitan desde la interfaz (Camaras -> + Agregar camara).
# CAM_MAX=8                 # camaras registrables a la vez (cada activa consume CPU de YOLO y tokens)
# CAM_MAX_MIN=120           # corte automatico por sesion de camara; 0 = sin corte (cuida el gasto de tokens)
# LOG_TZ=America/Mexico_City   # zona horaria que separa los dias de la bitacora
# EVENTS_KEEP_DAYS=30       # dias de bitacora por camara
# EVENT_MERGE_S=45          # detecciones iguales con menos de N s entre si = un solo incidente
# LIVE_ALLOWED_HOSTS=       # lista (coma) de hosts permitidos para camaras IP; vacio = cualquiera
# LIVE_TRANSPORT=tcp        # tcp | udp

# --- 5. Webhook: manda cada incidente a otro sistema (POST JSON) -------------
# WEBHOOK_URL=https://tu-servidor/hook
# WEBHOOK_TOKEN=            # opcional: Authorization: Bearer <token> y X-Vialert-Token
# WEBHOOK_MIN_SEV=low       # low | medium | high
# WEBHOOK_IMAGE=0           # 1 = incluye el frame de evidencia en base64
# WEBHOOK_COOLDOWN_S=30
# WEBHOOK_ALERTS=0          # 1 = tambien alertas de YOLO / camara

# --- 6. Escenario 2: video -> OBS -> FunctionGraph -> Vialert -> resultado en OBS ---
# INGEST_TOKEN=             # secreto compartido con la funcion (openssl rand -hex 16)
# OBS_ENDPOINT=https://obs.la-north-2.myhuaweicloud.com
# OBS_BUCKETS=mi-bucket
# OBS_AK=
# OBS_SK=
# OBS_USE_AGENCY=0          # 1 = usar una agencia IAM asignada a la ECS en lugar de OBS_AK/OBS_SK
# OBS_OUT_PREFIX=vialert-results/

# --- 7. Analisis (valores por defecto razonables) ----------------------------
# FRAME_INTERVAL=5          # s entre frames base
# CONTEXT_FRAMES=1          # 0 = solo el frame actual (mas rapido)
# BUDGET_MS=7000
# DESCRIBE=1                # 0 = sin descripcion de escena (menos latencia y tokens)
# ADAPTIVE=1                # 0 = solo frames base
# YOLO=1                    # 0 = sin YOLO
# YOLO_WEIGHTS=yolo11s.pt   # por defecto el modelo s (detallado). Con 4+ camaras en vivo en 4 vCPU: yolo11n.pt (mas rapido)
# YOLO_IMGSZ=800            # tamano de imagen; 960 ve objetos mas pequenos/lejanos (mas lento); 640 es mas rapido
# YOLO_CONF=0.25            # confianza minima; mas bajo = mas detecciones (y mas falsas alarmas que el VLM descarta)
# YOLO_FPS=3                # muestras/s en videos y OBS;  YOLO_LIVE_FPS=2 en camaras en vivo
# FIRE=1                    # detector LOCAL de llamas/humo (color + parpadeo): pide un frame extra al VLM; 0 = apagado
# MAX_EXTRA_PER_MIN=14      # tope de frames extra (alertas + movimiento) por minuto de video
# QUALITY=1                 # 0 = sin analitica de calidad de camara
# AUTOCROP=0
